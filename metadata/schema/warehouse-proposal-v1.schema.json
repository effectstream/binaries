{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/effectstream/binaries/metadata/schema/warehouse-proposal-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "proposalId", "destination", "publicationState", "payloadCount",
    "evidenceRequired", "binaryPayloads", "proofPayloads", "compactPayloadCount", "warning"
  ],
  "properties": {
    "schemaVersion": {"const": "warehouse-proposal-v1"},
    "proposalId": {"const": "initial-31-v1"},
    "destination": {
      "const": {
        "repository": "effectstream/binaries",
        "releaseTag": "0.3.120",
        "distributionTier": "development-only",
        "releaseMutability": "mutable-warehouse"
      }
    },
    "publicationState": {"const": "planned"},
    "payloadCount": {"const": 31},
    "evidenceRequired": {
      "const": [
        "source-manifest", "checksums", "license", "provenance", "attestation",
        "software-sbom-or-proof-member-lineage"
      ]
    },
    "binaryPayloads": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "proofPayloads": {"type": "array", "minItems": 21, "maxItems": 21, "uniqueItems": true, "items": {"type": "string"}},
    "compactPayloadCount": {"const": 0},
    "warning": {"const": "DEVELOPMENT ONLY — NOT FOR PRODUCTION USE. Release `0.3.120` is mutable; verify every downloaded SHA-256 against committed metadata before installation or execution."}
  }
}
