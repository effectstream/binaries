{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/effectstream/binaries/metadata/schema/artifact-catalog-v1.schema.json",
  "title": "Effectstream development artifact catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "repository", "release", "warning", "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "artifact-catalog-v1" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName", "id", "nodeId"],
      "properties": {
        "fullName": { "const": "effectstream/binaries" },
        "id": { "const": 1117580582 },
        "nodeId": { "const": "R_kgDOQpztJg" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "id", "nodeId", "url", "mutable"],
      "properties": {
        "tag": { "const": "0.3.120" },
        "id": { "const": 270761136 },
        "nodeId": { "const": "RE_kwDOQpztJs4QI3yw" },
        "url": { "const": "https://github.com/effectstream/binaries/releases/tag/0.3.120" },
        "mutable": { "const": true }
      }
    },
    "warning": {
      "const": "DEVELOPMENT ONLY — NOT FOR PRODUCTION USE. Release `0.3.120` is mutable; verify every downloaded SHA-256 against committed metadata before installation or execution."
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
    "exactConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proofServerVersion", "sourceCommit", "imageDigest", "ledgerStaticSemver", "cacheNamespace"],
      "properties": {
        "proofServerVersion": { "const": "9.0.0-rc.5" },
        "sourceCommit": { "const": "7a89f45d29792be7e09ca5eb246f1e69f0b2a179" },
        "imageDigest": {
          "enum": [
            "sha256:d96a4d0f3f0f10f82698288443f2873a32fed180eb8f93c0bae83572c0a187a9",
            "sha256:4f02ca2734649eb238d13924df299b1c82bd5546ec928c5d67bdd0ce86dd0bd1"
          ]
        },
        "ledgerStaticSemver": { "const": "9.0.0" },
        "cacheNamespace": { "const": "9" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "nodeId", "name", "state", "size", "apiDigest",
        "sha256", "apiUrl", "downloadUrl", "contentType", "createdAt", "updatedAt"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "state": { "const": "uploaded" },
        "size": { "type": "integer", "minimum": 0 },
        "apiDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "apiUrl": { "type": "string", "pattern": "^https://api[.]github[.]com/repos/effectstream/binaries/releases/assets/[0-9]+$" },
        "downloadUrl": { "type": "string", "pattern": "^https://github[.]com/effectstream/binaries/releases/download/0[.]3[.]120/[A-Za-z0-9._-]+$" },
        "contentType": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "memberCount", "expandedSize", "members", "legacyAnomalies"],
      "properties": {
        "format": { "enum": ["zip", "tar.gz", "raw"] },
        "memberCount": { "type": "integer", "minimum": 1 },
        "expandedSize": { "type": "integer", "minimum": 0 },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type", "size", "storedMode", "installMode"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "type": { "enum": ["file", "directory", "symlink", "other"] },
              "size": { "type": "integer", "minimum": 0 },
              "storedMode": { "$ref": "#/$defs/mode" },
              "installMode": { "$ref": "#/$defs/mode" }
            }
          }
        },
        "legacyAnomalies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distributionSigningState", "codeSignatureKind", "cdhash", "authorities", "teamId", "hardenedRuntime", "strictVerification"],
      "properties": {
        "distributionSigningState": {
          "enum": [
            "UNSIGNED_DEVELOPMENT_ONLY",
            "DEVELOPER_ID_SIGNED_NOT_NOTARIZED",
            "DEVELOPER_ID_SIGNED_NOTARIZED_ONLINE_TICKET",
            "legacy-unverified"
          ]
        },
        "codeSignatureKind": { "enum": ["none", "linker-adhoc", "developer-id", "unknown"] },
        "cdhash": { "type": ["string", "null"] },
        "authorities": { "type": "array", "items": { "type": "string" } },
        "teamId": { "type": ["string", "null"] },
        "hardenedRuntime": { "type": ["boolean", "null"] },
        "strictVerification": { "enum": ["pass", "fail", "unknown"] }
      }
    },
    "proofData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "installedPath", "installedMode", "exactConsumers"],
      "properties": {
        "kind": { "enum": ["srs", "ledger-static"] },
        "k": { "type": "integer", "minimum": 0, "maximum": 19 },
        "srsGeneration": { "type": "string", "minLength": 1 },
        "officialAlias": { "type": ["string", "null"] },
        "cacheAlias": { "type": "string", "minLength": 1 },
        "ledgerStaticSemver": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
        "cacheNamespace": { "type": "string", "pattern": "^[0-9]+$" },
        "memberManifestSha256": { "$ref": "#/$defs/sha256" },
        "ledgerStaticRevision": { "type": "string", "minLength": 1 },
        "installedPath": { "type": "string", "minLength": 1 },
        "installedMode": { "const": "0644" },
        "exactConsumers": { "type": "array", "items": { "$ref": "#/$defs/exactConsumer" }, "minItems": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticId", "artifactKind", "family", "platform", "publicationState",
        "distributionTier", "releaseMutability", "asset", "archive", "source",
        "evidence", "legacyProvenance"
      ],
      "properties": {
        "semanticId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
        "artifactKind": { "enum": ["software", "proof-data"] },
        "family": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "variant": { "type": ["string", "null"] },
        "platform": { "enum": ["linux/amd64", "linux/arm64", "macos/amd64", "macos/arm64", "noarch"] },
        "os": { "enum": ["linux", "macos"] },
        "arch": { "enum": ["amd64", "arm64"] },
        "coverageTier": { "enum": ["required", "desired", "optional", "legacy"] },
        "publicationState": { "enum": ["planned", "uploading", "verified", "published", "revoked"] },
        "distributionTier": { "const": "development-only" },
        "releaseMutability": { "const": "mutable-warehouse" },
        "asset": { "$ref": "#/$defs/asset" },
        "archive": { "$ref": "#/$defs/archive" },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "mode"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "mode": { "$ref": "#/$defs/mode" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "repository", "commitSha", "license", "redistributionEvidence"],
          "properties": {
            "method": { "enum": ["build", "identity-mirror", "rename-only", "repackage", "assemble-data", "legacy-unknown"] },
            "repository": { "type": ["string", "null"] },
            "commitSha": { "type": ["string", "null"] },
            "license": { "type": ["string", "null"] },
            "redistributionEvidence": { "type": ["string", "null"] },
            "lockedDependenciesSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "toolchain": { "type": ["string", "null"] },
            "flags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "native": { "type": ["boolean", "null"] },
            "upstreamAssetId": { "type": ["integer", "null"], "minimum": 1 },
            "upstreamAssetNodeId": { "type": ["string", "null"] },
            "upstreamAssetName": { "type": ["string", "null"] },
            "upstreamAssetSize": { "type": ["integer", "null"], "minimum": 0 },
            "upstreamAssetSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceManifest", "checksums", "provenance", "sbom", "memberLineage"],
          "properties": {
            "sourceManifest": { "type": ["string", "null"] },
            "checksums": { "type": ["string", "null"] },
            "provenance": { "type": ["string", "null"] },
            "sbom": { "type": ["string", "null"] },
            "memberLineage": { "type": ["string", "null"] }
          }
        },
        "signing": { "$ref": "#/$defs/signing" },
        "proofData": { "$ref": "#/$defs/proofData" },
        "legacyProvenance": { "enum": ["known", "unknown", "legacy-unverified"] }
      },
      "allOf": [
        {
          "if": { "properties": { "artifactKind": { "const": "software" } } },
          "then": {
            "required": ["version", "os", "arch", "coverageTier", "install"],
            "properties": { "platform": { "not": { "const": "noarch" } } },
            "not": { "required": ["proofData"] }
          }
        },
        {
          "if": { "properties": { "artifactKind": { "const": "proof-data" } } },
          "then": {
            "required": ["proofData"],
            "properties": { "platform": { "const": "noarch" } },
            "not": { "anyOf": [{ "required": ["os"] }, { "required": ["arch"] }, { "required": ["signing"] }] }
          }
        },
        {
          "if": { "properties": { "platform": { "const": "macos/arm64" } } },
          "then": { "required": ["signing"] }
        },
        {
          "if": { "properties": { "platform": { "const": "macos/amd64" } } },
          "then": { "required": ["signing"] }
        },
        {
          "if": { "properties": { "publicationState": { "const": "published" } } },
          "then": { "properties": { "asset": { "$ref": "#/$defs/asset" } } }
        }
      ]
    }
  }
}
